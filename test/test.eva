@dev
start: "Hello, world!"
name: "Lucas"
age: 16
msg: important(
    format(
        "{} My name is {} and i am {} years old",
        ref(start),
        ref(name),
        ref(age)
    )
)

map: debug({
    [ref(name)]: "value1"
    key2: "value2"
})

keys: debug(merge(ref(map), { [ref(name)]: "ok" }))

coalesce: debug(
    important(coalesce(
        nil,
        nil,
        nil
    ))
)
